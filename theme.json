        { "slug": "paper", "name": "Paper", "color": "#F6F1E8" },
        { "slug": "ink", "name": "Ink", "color": "#1A1814" },
        { "slug": "muted", "name": "Muted", "color": "#5C5650" },
        { "slug": "accent", "name": "Accent", "color": "#B42318" }
      ]
    },
